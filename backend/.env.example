# Copy this file to `.env` and change what you need.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://paradox:paradox@localhost:5432/interspecies

# JWT signing secret: use a long random string outside of local dev
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# The story happens in 2126. Seasons (nesting, hibernation...) use this date.
# Set to "real" to use today's real date.
SIMULATED_TODAY=2126-05-20

# OSRM routing and Nominatim search through OpenStreetMap servers.
# Set to false to stay fully offline (the built-in path network is used).
ENABLE_EXTERNAL_GEO=true
OSRM_BASE_URL=https://routing.openstreetmap.de
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
