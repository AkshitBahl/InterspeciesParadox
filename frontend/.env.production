# Used by `npm run build` (and so by Vercel). The live site talks to the backend on Render.
# If Render gives the API a different address, set VITE_API_BASE_URL in Vercel's
# Environment Variables: values set there win over this file.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=https://interspecies-paradox-api.onrender.com
